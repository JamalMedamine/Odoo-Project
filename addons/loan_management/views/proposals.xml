<odoo>
    <record id="action_loan_proposals" model="ir.actions.act_window">
        <field name="name">Loan Proposals</field>
        <field name="res_model">loan.proposal</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_loan_proposal_list" model="ir.ui.view">
        <field name="name">loan.proposal.list</field>
        <field name="model">loan.proposal</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="amount"/>
                <field name="term"/>
                <field name="interest_rate"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_loan_proposal_form" model="ir.ui.view">
        <field name="name">loan.proposal.form</field>
        <field name="model">loan.proposal</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="amount"/>
                        <field name="term"/>
                        <field name="interest_rate"/>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>